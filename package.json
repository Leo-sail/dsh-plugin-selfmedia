{
  "name": "dsh-plugin-selfmedia",
  "version": "0.1.0",
  "description": "Self-media content production pipeline for DSH: AI news collection, daily briefing, topic planning, drafting, polishing, visual layout, and multi-author style archiving.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "presets",
    "schemas",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "screenshots.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh-plugin",
    "self-media",
    "content-pipeline",
    "briefing",
    "aihot"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/selfmedia/preset.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-base": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.6",
    "@deepseek-ai/dsh-base": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leochang/dsh-plugin-selfmedia.git"
  },
  "author": {
    "name": "leochang",
    "email": "leochang210@gmail.com"
  }
}
